# --- build output ---------------------------------------------------------
# DOSBox-X mounts this as D: and BUILD.BAT writes into it. Everything here is
# regenerated by `python v1.31b/build.py`; nothing here is a source.
/build/

# --- the reference image --------------------------------------------------
# The measurement target: NEUROSIS.008 unpacked. A third-party binary lifted
# out of someone else's release, so the tree carries it and git does not.
# See v1.31b/ref/README.md for how to recreate it. The README itself IS tracked.
/v1.31b/ref/*
!/v1.31b/ref/README.md

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
