# --- build output ---------------------------------------------------------
# DOSBox-X mounts this as D: and BUILD.BAT writes into it. Everything here is
# regenerated by `python v1.31b/build.py`; nothing here is a source.
/build/

# The reference image v1.31b/ref/vt1.31b.bin IS tracked, deliberately -- the
# measurement target belongs with the measurements. See v1.31b/ref/README.md.

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# The kit's machine-specific answers: real local paths, so never committed.
# kit.toml holds the relative ones and IS committed.
kit.local.toml

# AI ignores
.claude
.mcp.json

# v1.51's DOSBox scratch. Its own host root, so its build directory is its
# own; everything in it is regenerated by build.py and nothing in it is a
# source. The RTL probe's staging directory is scratch for the same reason.
/v1.51/build/
/build51/

# The Ghidra project for the v1.51 image. A working artefact with locks and a
# per-machine repository inside it; the FINDINGS belong in docs/, not here.
/v1.51/ghidra/
