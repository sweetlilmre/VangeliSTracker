# --- build output ---------------------------------------------------------
# Each reconstruction is its own host root and keeps its own build directory.
# DOSBox-X mounts one as D: and BUILD.BAT writes into it. Everything in them is
# regenerated by `kit/tools/pascal/build.py`; nothing in them is a source.
# build51/ is the RTL probe's staging directory, scratch for the same reason.
/v1.31b/build/
/v1.51/build/
/build51/

# The reference image v1.31b/ref/vt1.31b.bin IS tracked, deliberately -- the
# measurement target belongs with the measurements. See v1.31b/ref/README.md.

# --- python ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/

# --- editors and OS -------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# The kit's machine-specific answers: real local paths, so never committed.
# kit.toml holds the relative ones and IS committed.
kit.local.toml

# AI ignores
.claude
.mcp.json

# The Ghidra project for the v1.51 image. A working artefact with locks and a
# per-machine repository inside it; the FINDINGS belong in docs/, not here.
/v1.51/ghidra/

# asmgen's scratch folder. `[assembler].workdir` names it and defaults to
# this; the tool's docstring says to ignore whatever you name, because it
# is created beside the config -- a repository root -- on every run.
asmwork/
